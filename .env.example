# Variables de entorno — ColombiaTIC frontend
# Copia este archivo a .env.local y completa los valores. No subas secretos al repositorio.

# ── Contacto / capturas de leads (src/app/api/lead/route.ts) ────────────────

# Clave de Resend. Sin esto el lead NO se envía por correo y la ruta responde
# 502 cuando tampoco hay backend configurado.
# Crear en https://resend.com/api-keys
# Basta una key de solo envío ("Restricted"/"Sending only"): la ruta no gestiona
# dominios. Para registrar colombiatic.com.co usa el dashboard de Resend.
RESEND_API_KEY=

# Remitente. Debe usar un dominio verificado en Resend.
# onboarding@resend.dev solo puede enviar a la cuenta titular (util para pruebas).
LEAD_FROM_EMAIL=ColombiaTIC <onboarding@resend.dev>

# A quién llega la notificación interna de cada lead.
LEAD_NOTIFICATION_EMAIL=enterprise@colombiatic.com.co

# Backend opcional para persistir el lead. Base sin /demo-leads, por ejemplo
# https://tu-backend/api  — si el host no responde, el lead igual se envía por correo.
LEAD_API_BASE=

# ── Build ──────────────────────────────────────────────────────────────────
NODE_VERSION=20
